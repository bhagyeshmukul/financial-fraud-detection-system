# Copy to .env.production and replace every secret placeholder before deployment.
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=replace-with-a-generated-database-password
ANALYST_USER=analyst
ANALYST_PASSWORD=replace-with-at-least-twelve-characters
API_ACCESS_TOKEN=replace-with-at-least-32-url-safe-random-characters
WEB_CONCURRENCY=2
WEB_PORT=8080
# Optional managed DB; percent-encode credentials and require TLS.
# DATABASE_URL=postgresql+psycopg2://user:encoded-password@host:5432/fraud_db?sslmode=require
